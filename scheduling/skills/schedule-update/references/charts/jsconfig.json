{
  "compilerOptions": {
    "target":           "ES2022",
    "module":           "ESNext",
    "moduleResolution": "Bundler",
    "allowJs":          true,
    "checkJs":          true,
    "noEmit":           true,
    "strict":           true,
    "skipLibCheck":     true,
    "maxNodeModuleJsDepth": 0,
    "lib":              ["ES2022"]
  },
  "include": ["*.js", "tests/**/*.js"],
  "exclude": ["node_modules"]
}
